# pro-ember: warm dark: charcoal background with an orange accent
# Bundled with mpljs. Use it in matplotlib too: plt.style.use("path/to/pro-ember.mplstyle")

figure.facecolor: 141210
axes.facecolor: 141210
axes.edgecolor: 3d3631
grid.color: 26221e
text.color: f4ede6
axes.titlecolor: f4ede6
axes.labelcolor: a39a91
xtick.color: 3d3631
ytick.color: 3d3631
xtick.labelcolor: a39a91
ytick.labelcolor: a39a91
patch.edgecolor: 141210
axes.prop_cycle: cycler('color', ['f6821f', 'fbad41', 'e2e0dc', '8d8580', 'e05d44', '5f5a55'])
font.family: Inter
font.size: 9
figure.figsize: 7.2, 4.2
axes.spines.top: False
axes.spines.right: False
axes.spines.left: False
axes.grid: True
axes.grid.axis: y
axes.axisbelow: True
axes.linewidth: 0.8
axes.titlesize: 12
axes.titlelocation: left
axes.titlepad: 10
axes.labelsize: 9
axes.labelpad: 6
grid.linestyle: -
grid.linewidth: 0.6
lines.linewidth: 1.6
lines.solid_capstyle: round
lines.markersize: 5
patch.linewidth: 0
xtick.major.size: 3
xtick.major.width: 0.8
xtick.major.pad: 5
xtick.labelsize: 8.5
xtick.direction: out
ytick.major.size: 0
ytick.major.pad: 6
ytick.labelsize: 8.5
legend.frameon: False
legend.fontsize: 8.5
legend.handlelength: 1.4
legend.handletextpad: 0.6
legend.columnspacing: 1.4
